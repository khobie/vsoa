# ============================================================================
# Environment configuration — copy to .env for local development.
# NEVER commit real values. On Vercel, set these in Project → Settings →
# Environment Variables. The Vercel–Neon integration fills DATABASE_URL
# automatically when you connect a Neon database.
# ============================================================================

# Neon PostgreSQL connection string (pooled)
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# Session cookie signing secret (generate: openssl rand -base64 32)
SESSION_SECRET="change-me"

# Staff passwords use scrypt. Voting tokens use SHA-256 hashes for login and
# AES-256-GCM encryption for authorized SMS exports. Generate the 32-byte key:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY="change-me"
VOTING_TOKEN_HOURS="72"

# Optional bulk-SMS gateway. Without these values, registration still works and
# administrators can use the secure CSV export instead of automatic SMS/OTP.
SMS_WEBHOOK_URL=""
SMS_WEBHOOK_SECRET=""
SMS_SENDER_ID="SOA-SRC"

# Institution
INSTITUTION_NAME="School of Anaesthesia Ridge"
INSTITUTION_TIMEZONE="Africa/Accra"

# One-time DB setup endpoint guard (removed before real elections)
SETUP_SECRET="change-me"
